{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARC Binary Manifest v4",
  "type": "object",
  "required": [
    "version",
    "object_id",
    "content_class",
    "codec",
    "payload_sha256",
    "size_bytes",
    "chunk_size",
    "chunks",
    "merkle_root",
    "manifest_sha256"
  ],
  "properties": {
    "version": {
      "const": 4
    },
    "object_id": {
      "type": "string"
    },
    "content_class": {
      "type": "string"
    },
    "codec": {
      "type": "string"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "chunk_size": {
      "type": "integer",
      "minimum": 1
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "sha256",
          "size_bytes",
          "store_path"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "store_path": {
            "type": "string"
          }
        }
      }
    },
    "merkle_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_path": {
      "type": "string"
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "language_link": {
      "type": "object"
    },
    "sure_recipe": {
      "type": "object"
    },
    "created_utc": {
      "type": "string"
    }
  }
}