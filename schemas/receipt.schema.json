{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARC-Apache Receipt v5",
  "type": "object",
  "required": ["version", "receipt_type", "source", "manifest_sha256", "envelope_sha256", "merkle_root", "receipt_sha256"],
  "properties": {
    "version": {"const": 5},
    "receipt_type": {"type": "string"},
    "source": {"type": "string"},
    "actor": {"type": "string"},
    "policy_status": {"type": "string"},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "envelope_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "merkle_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parent_receipts": {"type": "array", "items": {"type": "string"}},
    "signature": {"type": ["object", "null"]},
    "receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
